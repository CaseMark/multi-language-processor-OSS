# ============================================
# CASE.DEV API (Required)
# ============================================

# Get your API key from https://console.case.dev
# Used for OCR, translation, and language detection
CASE_API_KEY=sk_case_...

# ============================================
# OPTIONAL (for development/advanced features)
# ============================================

# Database (Neon PostgreSQL) - for persistent storage
# DATABASE_URL=postgres://...

# Authentication (Better Auth) - for user accounts
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
